        </mxCell>
        <mxCell id="K_rXWSAAHu0PieQSRRX3-39" value="&lt;b&gt;Искажение данных &lt;/b&gt;- КРИТИЧЕСКИЙ&lt;div&gt;Клиенты могут получить недостоверную информацию по объектам недвижимости, что в свою очередь приведет к путанице, упущенной прибыли, совранным сделкам и снижению лояльности клиентов&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="880" y="410" width="393" height="62.5" as="geometry" />
        </mxCell>
        <mxCell id="K_rXWSAAHu0PieQSRRX3-41" value="&lt;b&gt;Искажение данных &lt;/b&gt;- ЗНАЧИТЕЛЬНЫЙ&lt;div&gt;Искажение бухгалтерских данных могут породить некорректную отчетность и последующие проблемы с гос. органами, что повлечет за собой штрафы и снижение репутации&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="870" y="507.5" width="393" height="62.5" as="geometry" />
        </mxCell>
        <mxCell id="K_rXWSAAHu0PieQSRRX3-42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.025;entryY=0.38;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="K_rXWSAAHu0PieQSRRX3-18" target="K_rXWSAAHu0PieQSRRX3-41">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="K_rXWSAAHu0PieQSRRX3-43" value="&lt;b&gt;Утечка данных &lt;/b&gt;- КРИТИЧЕСКИЙ&lt;div&gt;Утечка персональных данных клиентов и собственников повлечет за собой наложение штрафов, снижение репутации и потере доверия клиентов.&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="870" y="583.75" width="393" height="62.5" as="geometry" />
        </mxCell>
        <mxCell id="K_rXWSAAHu0PieQSRRX3-45" value="&lt;b&gt;Утечка данных &lt;/b&gt;- КРИТИЧЕСКИЙ&lt;div&gt;Утечка секретных данных может привести к прямым финансовым потерям клиентов и компании&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
