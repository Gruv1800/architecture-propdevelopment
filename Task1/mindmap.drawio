        <mxCell id="K_rXWSAAHu0PieQSRRX3-19" value="&lt;div style=&quot;background-color:#ffffff;color:#080808&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:12,0pt;&quot;&gt;Клиентские данные&lt;br&gt;Данные о собственниках&lt;br&gt;Учетные данные&lt;br&gt;Сделки по объектам недвижимости&lt;/pre&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
